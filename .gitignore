# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor / IDE
.vscode/
.idea/
*.swp
*~

# Node (the fixture validator, the parity harness, the site generator)
node_modules/
npm-debug.log*
yarn-error.log*
dist/

# @coffeejson/core ships the schema files; the copy is generated by its build
packages/core/schema/

# apps/site generated artifacts (rebuilt by `pnpm gen`)
apps/site/src/generated/
apps/site/public/schema/
apps/site/public/demo/
apps/site/public/sitemap.xml
apps/site/public/llms.txt
apps/site/public/llms-full.txt
apps/site/public/docs/
apps/site/public/registries/

# apps/site corpus pages (one per document, written by `pnpm gen`;
# the hand-written apps/site/recipes/index.html stays tracked)
apps/site/recipes/*/
# apps/site bean pages (one per bean identity, same arrangement — the
# hand-written apps/site/beans/index.html hub stays tracked)
apps/site/beans/*/
